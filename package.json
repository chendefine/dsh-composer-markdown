{
  "name": "dsh-composer-markdown",
  "version": "0.1.0",
  "description": "DSH web 插件：对话输入框 Markdown 编辑增强 —— 无序/有序列表自动续行、行内代码样式（保留字面反引号）、代码块围栏自动闭合与围栏内 Enter 保护。仅增强编辑态视觉与按键行为，发送文本保持字面 Markdown 逐字节保真。/ DSH web plugin: markdown editing aids for the composer — list continuation, inline-code styling (literal backticks kept), code-fence auto-closing with in-fence Enter protection. Edit-state visuals only; the submitted text stays literal markdown.",
  "type": "module",
  "main": "./index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chendefine/dsh-composer-markdown.git"
  },
  "homepage": "https://github.com/chendefine/dsh-composer-markdown#readme",
  "bugs": {
    "url": "https://github.com/chendefine/dsh-composer-markdown/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "prepare": "node scripts/build.mjs",
    "prepublishOnly": "node scripts/build.mjs && node tests/run-tests.mjs",
    "test": "node tests/run-tests.mjs"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-client-plugin",
    "composer",
    "markdown",
    "lexical",
    "code-fence",
    "inline-code"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src/client",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ]
}
